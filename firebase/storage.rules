rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data;
    }

    function allowedDocumentMimeType(value) {
      return value in [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "image/webp",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ];
    }

    function allowedPhotoMimeType(value) {
      return value in [
        "image/png",
        "image/jpeg",
        "image/webp"
      ];
    }

    function validDocumentUpload(ownerId, category, documentId) {
      return signedIn()
        && request.auth.uid == ownerId
        && currentProfile().role == "student"
        && category in ["online", "personal", "academic"]
        && request.resource.size > 0
        && request.resource.size <= 16 * 1024 * 1024
        && allowedDocumentMimeType(request.resource.contentType)
        && request.resource.metadata.documentId == documentId
        && request.resource.metadata.ownerId == ownerId
        && request.resource.metadata.category == category
        && request.resource.metadata.departmentKey == currentProfile().departmentKey
        && request.resource.metadata.year == currentProfile().year;
    }

    function canReadAcademicObject() {
      return signedIn()
        && resource.metadata.category == "academic"
        && currentProfile().role == "teacher"
        && currentProfile().departmentKey == resource.metadata.departmentKey
        && currentProfile().year == resource.metadata.year;
    }

    function canUseStoredDocument(ownerId) {
      return signedIn()
        && (request.auth.uid == ownerId || canReadAcademicObject());
    }

    match /documents/{ownerId}/{category}/{documentId}/{fileName} {
      allow read, delete: if canUseStoredDocument(ownerId);
      allow create: if validDocumentUpload(ownerId, category, documentId);
      allow update: if false;
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024
        && allowedPhotoMimeType(request.resource.contentType)
        && request.resource.metadata.ownerId == uid
        && request.resource.metadata.profileId == uid;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
