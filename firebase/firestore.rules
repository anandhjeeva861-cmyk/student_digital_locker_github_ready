rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return signedIn() && currentProfile().role == "teacher";
    }

    function isAdmin() {
      return signedIn() && currentProfile().role == "admin";
    }

    function approvedTeacher(data) {
      let approval = get(/databases/$(database)/documents/approvedTeachers/$(request.auth.token.email)).data;
      let approvedBatches = approval.get("teachingBatches", [approval.get("teachingBatch", "")]);
      return approval.enabled == true && approval.departmentKey == data.departmentKey
        && data.teachingBatch in approvedBatches;
    }

    match /approvedTeachers/{email} {
      allow get: if (signedIn() && request.auth.token.email == email) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["enabled", "department", "departmentKey", "teachingBatch", "teachingBatches", "updatedBy", "updatedAt"])
        && request.resource.data.enabled is bool
        && allowedDepartment(request.resource.data.department)
        && validDepartmentKey(request.resource.data)
        && request.resource.data.teachingBatch is string
        && validAcademicYear(request.resource.data.teachingBatch)
        && request.resource.data.teachingBatches is list
        && request.resource.data.teachingBatches.size() > 0
        && request.resource.data.teachingBatches.size() <= 12
        && request.resource.data.teachingBatch in request.resource.data.teachingBatches
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    function allowedDepartment(value) {
      return value in [
        "BSC CS",
        "BSC AI&ML",
        "BSC IT",
        "CSDA",
        "BCOM",
        "BCOM CA",
        "BCOM PA",
        "CS&HM",
        "BCOM IT",
        "MBA",
        "BBA"
      ];
    }

    function validAcademicYear(value) {
      return value is string && value.matches("^20[0-9]{2}-20[0-9]{2}$");
    }

    function allowedYear(value) {
      return validAcademicYear(value) || allowedLegacyYear(value);
    }

    function allowedLegacyYear(value) {
      return value in ["I", "II", "III"];
    }

    function teacherTeachingBatch(profile) {
      return profile.get("teachingBatch", profile.get("year", ""));
    }

    function teacherTeachingBatches(profile) {
      return profile.get("teachingBatches", [teacherTeachingBatch(profile)]);
    }

    function teacherCanTeachBatch(profile, batchLabel) {
      return batchLabel is string && batchLabel in teacherTeachingBatches(profile);
    }

    function validDepartmentKey(data) {
      return (data.department == "BSC CS" && data.departmentKey == "BSCCS")
        || (data.department == "BSC AI&ML" && data.departmentKey == "BSCAIML")
        || (data.department == "BSC IT" && data.departmentKey == "BSCIT")
        || (data.department == "CSDA" && data.departmentKey == "CSDA")
        || (data.department == "BCOM" && data.departmentKey == "BCOM")
        || (data.department == "BCOM CA" && data.departmentKey == "BCOMCA")
        || (data.department == "BCOM PA" && data.departmentKey == "BCOMPA")
        || (data.department == "CS&HM" && data.departmentKey == "CSHM")
        || (data.department == "BCOM IT" && data.departmentKey == "BCOMIT")
        || (data.department == "MBA" && data.departmentKey == "MBA")
        || (data.department == "BBA" && data.departmentKey == "BBA");
    }

    function profileDepartmentKeyMatches(profile, departmentKey) {
      return profile.departmentKey == departmentKey
        || (profile.department == "BSC CS" && departmentKey == "BSCCS")
        || (profile.department == "BSC AI&ML" && departmentKey == "BSCAIML")
        || (profile.department == "BSC IT" && departmentKey == "BSCIT")
        || (profile.department == "CSDA" && departmentKey == "CSDA")
        || (profile.department == "BCOM" && departmentKey == "BCOM")
        || (profile.department == "BCOM CA" && departmentKey == "BCOMCA")
        || (profile.department == "BCOM PA" && departmentKey == "BCOMPA")
        || (profile.department == "CS&HM" && departmentKey == "CSHM")
        || (profile.department == "BCOM IT" && departmentKey == "BCOMIT")
        || (profile.department == "MBA" && departmentKey == "MBA")
        || (profile.department == "BBA" && departmentKey == "BBA");
    }

    function profileRegNoMatches(profile, regNo) {
      return profile.regNo == regNo || profile.reg_no == regNo;
    }

    function matchesCurrentProfileScope(data) {
      return profileDepartmentKeyMatches(currentProfile(), data.departmentKey)
        || data.department == currentProfile().department;
    }

    function teacherAssignedToBatch(batchId) {
      return signedIn()
        && isTeacher()
        && batchId is string
        && batchId.size() > 0
        && exists(/databases/$(database)/documents/batches/$(batchId))
        && get(/databases/$(database)/documents/batches/$(batchId)).data.assignedTeacherUid == request.auth.uid;
    }

    function activeAssignedBatch(batchId) {
      return teacherAssignedToBatch(batchId)
        && get(/databases/$(database)/documents/batches/$(batchId)).data.status == "active";
    }

    function convertibleBatch(batchId) {
      return teacherAssignedToBatch(batchId)
        && get(/databases/$(database)/documents/batches/$(batchId)).data.status in ["active", "graduating"];
    }

    function graduationYearReached(batchId) {
      let graduationYear = get(/databases/$(database)/documents/batches/$(batchId)).data.graduationYear;
      return graduationYear is int
        && request.time >= timestamp.date(graduationYear, 1, 1);
    }

    function inferredBatchId(data) {
      return data.get("departmentKey", currentProfile().departmentKey) + "_" + data.year;
    }

    function validProfileCreate(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.role in ["student", "teacher"]
        && request.resource.data.name is string
        && request.resource.data.name.matches("^[A-Z ]{2,60}$")
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches("^[6-9][0-9]{9}$")
        && allowedDepartment(request.resource.data.department)
        && ((request.resource.data.role == "student" && validAcademicYear(request.resource.data.year))
          || (request.resource.data.role == "teacher" && validAcademicYear(request.resource.data.teachingBatch)))
        && validDepartmentKey(request.resource.data)
        && getAfter(/databases/$(database)/documents/uniqueMobileNumbers/$(request.resource.data.mobile)).data.uid == uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.role == "student"
            && request.resource.data.keys().hasOnly(["uid", "role", "name", "regNo", "email", "year", "batch", "batchId", "admissionYear", "graduationYear", "studentStatus", "department", "departmentKey", "mobile", "createdAt", "updatedAt"])
            && request.resource.data.batch == request.resource.data.year
            && request.resource.data.batchId == ""
            && request.resource.data.admissionYear is int
            && request.resource.data.graduationYear is int
            && request.resource.data.graduationYear == request.resource.data.admissionYear + 3
            && request.resource.data.year == string(request.resource.data.admissionYear) + "-" + string(request.resource.data.graduationYear)
            && request.resource.data.studentStatus == "active"
            && request.resource.data.regNo is string
            && request.resource.data.regNo.matches("^[0-9]{2}[A-Z]{3}[0-9]{3}$")
            && getAfter(/databases/$(database)/documents/uniqueRegisterNumbers/$(request.resource.data.regNo)).data.uid == uid)
          || (request.resource.data.role == "teacher"
            && approvedTeacher(request.resource.data)
            && request.resource.data.keys().hasOnly(["uid", "role", "name", "email", "teachingBatch", "teachingBatches", "department", "departmentKey", "mobile", "createdAt", "updatedAt"])
            && existsAfter(/databases/$(database)/documents/uniqueTeacherScopes/$(request.resource.data.departmentKey + "_" + request.resource.data.teachingBatch))
            && getAfter(/databases/$(database)/documents/uniqueTeacherScopes/$(request.resource.data.departmentKey + "_" + request.resource.data.teachingBatch)).data.uid == uid
            && getAfter(/databases/$(database)/documents/uniqueTeacherScopes/$(request.resource.data.departmentKey + "_" + request.resource.data.teachingBatch)).data.departmentKey == request.resource.data.departmentKey
            && getAfter(/databases/$(database)/documents/uniqueTeacherScopes/$(request.resource.data.departmentKey + "_" + request.resource.data.teachingBatch)).data.get("teachingBatch", getAfter(/databases/$(database)/documents/uniqueTeacherScopes/$(request.resource.data.departmentKey + "_" + request.resource.data.teachingBatch)).data.get("year", "")) == request.resource.data.teachingBatch));
    }

    function allowedDocumentMimeType(value) {
      return value in [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "image/webp",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ];
    }

    function allowedPhotoMimeType(value) {
      return value in [
        "image/png",
        "image/jpeg",
        "image/webp"
      ];
    }

    function validDocumentIdForCategory(documentId, category) {
      return documentId.matches("^" + request.auth.uid + "_" + category + "_.+$");
    }

    function validOwnedDocumentId(documentId) {
      return documentId.matches("^" + request.auth.uid + "_(online|personal|academic)_.+$");
    }

    function validDocumentMetadataBase(documentId) {
      return request.resource.data.keys().hasOnly([
          "id",
          "ownerId",
          "userId",
          "uploadedUserId",
          "uploadedUserEmail",
          "ownerName",
          "ownerRegNo",
          "department",
          "departmentKey",
          "year",
          "batchId",
          "category",
          "title",
          "originalName",
          "fileName",
          "storageProvider",
          "fileDataVersion",
          "chunkCount",
          "fileType",
          "mimeType",
          "size",
          "description",
          "accessLevel",
          "status",
          "uploadedAt",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.id == documentId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.uploadedUserId == request.auth.uid
        && request.resource.data.uploadedUserEmail == request.auth.token.email
        && request.resource.data.ownerName == currentProfile().name
        && profileRegNoMatches(currentProfile(), request.resource.data.ownerRegNo)
        && validDocumentIdForCategory(documentId, request.resource.data.category)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.originalName is string
        && request.resource.data.fileName is string
        && request.resource.data.storageProvider == "firestore"
        && request.resource.data.fileDataVersion is string
        && request.resource.data.fileDataVersion.size() > 0
        && request.resource.data.chunkCount is number
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 40
        && request.resource.data.fileType is string
        && request.resource.data.mimeType is string
        && allowedDocumentMimeType(request.resource.data.mimeType)
        && request.resource.data.description is string
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 16 * 1024 * 1024
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.batchId is string
        && request.resource.data.batchId == currentProfile().get("batchId", "");
    }

    function validDocumentCreate(documentId) {
      return validDocumentMetadataBase(documentId)
        && request.resource.data.createdAt == request.time;
    }

    function validDocumentUpdate(documentId) {
      return validDocumentMetadataBase(documentId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validFileChunk(documentId) {
      return request.resource.data.keys().hasOnly([
          "documentId",
          "ownerId",
          "category",
          "departmentKey",
          "year",
          "batchId",
          "fileDataVersion",
          "chunkIndex",
          "chunkCount",
          "data",
          "createdAt"
        ])
        && request.resource.data.documentId == documentId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.category in ["online", "personal", "academic"]
        && validDocumentIdForCategory(documentId, request.resource.data.category)
        && profileDepartmentKeyMatches(currentProfile(), request.resource.data.departmentKey)
        && request.resource.data.year == teacherTeachingBatch(currentProfile())
        && request.resource.data.batchId == currentProfile().get("batchId", "")
        && request.resource.data.fileDataVersion is string
        && request.resource.data.fileDataVersion.size() > 0
        && request.resource.data.chunkIndex is number
        && request.resource.data.chunkIndex >= 0
        && request.resource.data.chunkCount is number
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 40
        && request.resource.data.chunkIndex < request.resource.data.chunkCount
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 700000
        && request.resource.data.createdAt == request.time;
    }

    function validPhotoChunk(uid) {
      return request.resource.data.keys().hasOnly([
          "ownerId",
          "fileDataVersion",
          "chunkIndex",
          "chunkCount",
          "data",
          "createdAt"
        ])
        && request.resource.data.ownerId == uid
        && request.resource.data.fileDataVersion is string
        && request.resource.data.fileDataVersion.size() > 0
        && request.resource.data.chunkIndex is number
        && request.resource.data.chunkIndex >= 0
        && request.resource.data.chunkCount is number
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 8
        && request.resource.data.chunkIndex < request.resource.data.chunkCount
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 700000
        && request.resource.data.createdAt == request.time;
    }

    function validPhotoUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "photoProvider",
          "photoPath",
          "photoUrl",
          "photoFileDataVersion",
          "photoChunkCount",
          "photoMimeType",
          "photoOriginalName",
          "photoSize",
          "updatedAt"
        ])
        && request.resource.data.photoProvider == "firestore"
        && request.resource.data.photoPath == ""
        && request.resource.data.photoUrl == ""
        && request.resource.data.photoFileDataVersion is string
        && request.resource.data.photoFileDataVersion.size() > 0
        && request.resource.data.photoChunkCount is number
        && request.resource.data.photoChunkCount > 0
        && request.resource.data.photoChunkCount <= 8
        && allowedPhotoMimeType(request.resource.data.photoMimeType)
        && request.resource.data.photoOriginalName is string
        && request.resource.data.photoSize is number
        && request.resource.data.photoSize > 0
        && request.resource.data.photoSize <= 4 * 1024 * 1024
        && request.resource.data.updatedAt == request.time;
    }

    function validCareerProfile(status, data) {
      return data is map
        && ((status == "employed"
            && data.keys().hasOnly(["company", "jobTitle", "location", "joiningYear"])
            && data.keys().hasAll(["company", "jobTitle", "location", "joiningYear"])
            && data.company is string && data.company.size() > 0 && data.company.size() <= 100
            && data.jobTitle is string && data.jobTitle.size() > 0 && data.jobTitle.size() <= 100
            && data.location is string && data.location.size() > 0 && data.location.size() <= 100
            && data.joiningYear is int && data.joiningYear >= 1950 && data.joiningYear <= 2100)
          || (status == "higher_studies"
            && data.keys().hasOnly(["institution", "course", "location", "joiningYear"])
            && data.keys().hasAll(["institution", "course", "location", "joiningYear"])
            && data.institution is string && data.institution.size() > 0 && data.institution.size() <= 120
            && data.course is string && data.course.size() > 0 && data.course.size() <= 120
            && data.location is string && data.location.size() > 0 && data.location.size() <= 100
            && data.joiningYear is int && data.joiningYear >= 1950 && data.joiningYear <= 2100)
          || (status == "entrepreneur"
            && data.keys().hasOnly(["businessName", "role", "location", "startedYear"])
            && data.keys().hasAll(["businessName", "role", "location", "startedYear"])
            && data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 120
            && data.role is string && data.role.size() > 0 && data.role.size() <= 100
            && data.location is string && data.location.size() > 0 && data.location.size() <= 100
            && data.startedYear is int && data.startedYear >= 1950 && data.startedYear <= 2100)
          || (status == "seeking_opportunity"
            && data.keys().hasOnly(["areaOfInterest"])
            && data.areaOfInterest is string && data.areaOfInterest.size() > 0 && data.areaOfInterest.size() <= 160)
          || (status == "other"
            && data.keys().hasOnly(["description"])
            && data.description is string && data.description.size() > 0 && data.description.size() <= 500));
    }

    function validAlumniSelfUpdate() {
      return resource.data.role == "alumni"
        && request.resource.data.role == "alumni"
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(["careerStatus", "careerProfile", "updatedAt"])
            && request.resource.data.careerStatus in ["employed", "higher_studies", "entrepreneur", "seeking_opportunity", "other"]
            && validCareerProfile(request.resource.data.careerStatus, request.resource.data.careerProfile))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["personalEmail", "linkedin", "updatedAt"])
            && request.resource.data.personalEmail is string
            && request.resource.data.personalEmail.size() <= 160
            && (request.resource.data.personalEmail == "" || request.resource.data.personalEmail.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"))
            && request.resource.data.linkedin is string
            && request.resource.data.linkedin.size() <= 300
            && (request.resource.data.linkedin == "" || request.resource.data.linkedin.matches("^https://([A-Za-z0-9-]+\\.)*linkedin\\.com/.*$"))));
    }

    function validTeacherBatchAssignment() {
      let batchId = request.resource.data.batchId;
      let batch = get(/databases/$(database)/documents/batches/$(batchId)).data;
      return isTeacher()
        && resource.data.role == "student"
        && request.resource.data.role == "student"
        && resource.data.get("batchId", "") == ""
        && activeAssignedBatch(batchId)
        && batch.department == resource.data.department
        && batch.departmentKey == currentProfile().departmentKey
        && request.resource.data.departmentKey == batch.departmentKey
        && resource.data.year == batch.batchLabel
        && request.resource.data.batch == batch.batchLabel
        && request.resource.data.admissionYear == batch.admissionYear
        && request.resource.data.graduationYear == batch.graduationYear
        && request.resource.data.studentStatus == "active"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["departmentKey", "batchId", "batch", "admissionYear", "graduationYear", "studentStatus", "updatedAt"]);
    }

    function validTeacherBatchStudentRemoval() {
      return isTeacher()
        && resource.data.role == "student"
        && request.resource.data.role == "student"
        && resource.data.studentStatus == "active"
        && request.resource.data.studentStatus == "active"
        && resource.data.uid == request.resource.data.uid
        && resource.data.email == request.resource.data.email
        && resource.data.regNo == request.resource.data.regNo
        && resource.data.mobile == request.resource.data.mobile
        && request.resource.data.get("batchId", "") == ""
        && request.resource.data.get("batch", "") == ""
        && request.resource.data.get("admissionYear", null) == null
        && request.resource.data.get("graduationYear", null) == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["batchId", "batch", "admissionYear", "graduationYear", "studentStatus", "updatedAt"])
        && teacherAssignedToBatch(resource.data.get("batchId", ""));
    }

    function validTeacherAlumniConversion(uid) {
      let batchId = resource.data.batchId;
      let batch = get(/databases/$(database)/documents/batches/$(batchId)).data;
      return isTeacher()
        && resource.data.role == "student"
        && request.resource.data.role == "alumni"
        && convertibleBatch(batchId)
        && graduationYearReached(batchId)
        && resource.data.departmentKey == batch.departmentKey
        && resource.data.graduationYear == batch.graduationYear
        && request.resource.data.studentStatus == "graduated"
        && request.resource.data.alumniStatus == "active"
        && request.resource.data.graduationYear == batch.graduationYear
        && request.resource.data.batchId == batchId
        && request.resource.data.batch == batch.batchLabel
        && request.resource.data.graduatedAt == request.time
        && request.resource.data.convertedBy == request.auth.uid
        && request.resource.data.careerStatus == "not_updated"
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/alumniConversions/$(batchId + "_" + uid)).data.studentUid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "studentStatus", "alumniStatus", "graduationYear", "batchId", "batch", "graduatedAt", "convertedBy", "careerStatus", "updatedAt"]);
    }

    function isTeacherFor(data) {
      return signedIn()
        && isTeacher()
        && ((data.get("batchId", "") == ""
            && matchesCurrentProfileScope(data)
            && teacherCanTeachBatch(currentProfile(), data.year))
          || (data.get("batchId", "") != "" && teacherAssignedToBatch(data.batchId))
          || teacherAssignedToBatch(inferredBatchId(data))
          || (matchesCurrentProfileScope(data)
            && teacherCanTeachBatch(currentProfile(), data.year)
            && !exists(/databases/$(database)/documents/batches/$(inferredBatchId(data)))));
    }

    function canReadDocumentData(data) {
      return signedIn()
        && (data.ownerId == request.auth.uid
          || (data.category == "academic" && isTeacherFor(data)));
    }

    function isSameScope(data) {
      return signedIn()
        && matchesCurrentProfileScope(data)
        && teacherCanTeachBatch(currentProfile(), data.year);
    }

    function validAcademicTitleWrite() {
      return request.resource.data.keys().hasOnly([
          "title",
          "department",
          "departmentKey",
          "year",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.department == currentProfile().department
        && profileDepartmentKeyMatches(currentProfile(), request.resource.data.departmentKey)
        && teacherCanTeachBatch(currentProfile(), request.resource.data.year)
        && allowedDepartment(request.resource.data.department)
        && allowedYear(request.resource.data.year)
        && validDepartmentKey(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // Legacy recovery records can be removed by their owner; reset uses Firebase Auth email links.
    match /passwordRecovery/{email} {
      allow read, create, update: if false;
      allow delete: if signedIn() && request.auth.token.email == email;
      match /verifiers/{answerHash} {
        allow read, create, update: if false;
        allow delete: if signedIn() && request.auth.token.email == email;
      }
    }

    match /profiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validProfileCreate(uid);
      allow read: if signedIn()
        && (request.auth.uid == uid
          || isAdmin()
          || (isTeacher()
            && ((resource.data.role == "student" && isTeacherFor(resource.data))
              || (resource.data.role == "alumni" && teacherAssignedToBatch(resource.data.get("batchId", ""))))));
      allow update: if signedIn()
        && ((request.auth.uid == uid
            && resource.data.role in ["student", "alumni"]
            && (validPhotoUpdate() || validAlumniSelfUpdate()))
          || (isAdmin()
            && resource.data.role == "teacher"
            && request.resource.data.role == "teacher"
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["teachingBatch", "teachingBatches", "updatedAt"])
            && request.resource.data.teachingBatch is string
            && validAcademicYear(request.resource.data.teachingBatch)
            && request.resource.data.teachingBatches is list
            && request.resource.data.teachingBatches.size() > 0
            && request.resource.data.teachingBatches.size() <= 12
            && request.resource.data.teachingBatch in request.resource.data.teachingBatches
            && request.resource.data.updatedAt == request.time)
          || (request.auth.uid != uid
            && (validTeacherBatchAssignment() || validTeacherBatchStudentRemoval() || validTeacherAlumniConversion(uid))));
      allow delete: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == request.auth.uid;

      match /photoChunks/{chunkId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && currentProfile().role in ["student", "alumni"]
          && validPhotoChunk(uid);
        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid == uid
          && resource.data.ownerId == request.auth.uid;
      }
    }

    match /documents/{documentId} {
      allow create: if signedIn()
        && currentProfile().role in ["student", "alumni"]
        && validDocumentCreate(documentId)
        && request.resource.data.department == currentProfile().department
        && profileDepartmentKeyMatches(currentProfile(), request.resource.data.departmentKey)
        && request.resource.data.year == currentProfile().year
        && allowedDepartment(request.resource.data.department)
        && allowedYear(request.resource.data.year)
        && validDepartmentKey(request.resource.data)
        && request.resource.data.category in ["online", "personal", "academic"]
        && request.resource.data.status == "active"
        && ((request.resource.data.category == "academic" && request.resource.data.accessLevel == "teacher-visible")
          || (request.resource.data.category in ["online", "personal"] && request.resource.data.accessLevel == "private"));
      allow update: if signedIn()
        && currentProfile().role in ["student", "alumni"]
        && validDocumentUpdate(documentId)
        && request.resource.data.department == currentProfile().department
        && profileDepartmentKeyMatches(currentProfile(), request.resource.data.departmentKey)
        && request.resource.data.year == currentProfile().year
        && allowedDepartment(request.resource.data.department)
        && allowedYear(request.resource.data.year)
        && validDepartmentKey(request.resource.data)
        && request.resource.data.category in ["online", "personal", "academic"]
        && request.resource.data.status == "active"
        && ((request.resource.data.category == "academic" && request.resource.data.accessLevel == "teacher-visible")
          || (request.resource.data.category in ["online", "personal"] && request.resource.data.accessLevel == "private"));
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || (resource.data.category == "academic" && isTeacherFor(resource.data)));
      allow get: if signedIn()
        && currentProfile().role in ["student", "alumni"]
        && validOwnedDocumentId(documentId);
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || (resource.data.category == "academic" && isTeacherFor(resource.data)));

      match /fileChunks/{chunkId} {
        allow read: if canReadDocumentData(get(/databases/$(database)/documents/documents/$(documentId)).data);
        allow create: if signedIn()
          && currentProfile().role in ["student", "alumni"]
          && validFileChunk(documentId);
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.ownerId == request.auth.uid
            || canReadDocumentData(get(/databases/$(database)/documents/documents/$(documentId)).data));
      }
    }

    match /academicTitles/{titleId} {
      allow read: if signedIn() && isSameScope(resource.data);
      allow create, update: if signedIn()
        && isTeacher()
        && validAcademicTitleWrite();
      allow delete: if signedIn()
        && isTeacher()
        && resource.data.createdBy == request.auth.uid
        && profileDepartmentKeyMatches(currentProfile(), resource.data.departmentKey)
        && teacherCanTeachBatch(currentProfile(), resource.data.year);
    }

    match /batches/{batchId} {
      allow get: if isTeacher() && batchId == currentProfile().departmentKey + "_" + teacherTeachingBatch(currentProfile());
      allow read: if signedIn()
        && resource.data.assignedTeacherUid == request.auth.uid
        && isTeacher();
      allow create: if signedIn()
        && isTeacher()
        && request.resource.data.keys().hasOnly(["batchId", "department", "departmentKey", "courseName", "admissionYear", "graduationYear", "batchLabel", "status", "assignedTeacherUid", "createdAt", "updatedAt"])
        && request.resource.data.batchId == batchId
        && teacherCanTeachBatch(currentProfile(), request.resource.data.batchLabel)
        && batchId == request.resource.data.departmentKey + "_" + request.resource.data.batchLabel
        && request.resource.data.department == currentProfile().department
        && request.resource.data.departmentKey == currentProfile().departmentKey
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() > 0
        && request.resource.data.courseName.size() <= 120
        && request.resource.data.admissionYear is int
        && request.resource.data.graduationYear is int
        && request.resource.data.graduationYear == request.resource.data.admissionYear + 3
        && validAcademicYear(request.resource.data.batchLabel)
        && request.resource.data.batchLabel == string(request.resource.data.admissionYear) + "-" + string(request.resource.data.graduationYear)
        && request.resource.data.status == "active"
        && request.resource.data.assignedTeacherUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isTeacher()
        && resource.data.assignedTeacherUid == request.auth.uid
        && resource.data.status == "active"
        && request.time >= timestamp.date(resource.data.graduationYear, 1, 1)
        && request.resource.data.status == "graduating"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);
      allow update: if signedIn()
        && isTeacher()
        && resource.data.assignedTeacherUid == request.auth.uid
        && resource.data.status == "graduating"
        && request.time >= timestamp.date(resource.data.graduationYear, 1, 1)
        && request.resource.data.status == "graduated"
        && request.resource.data.graduatedAt == request.time
        && request.resource.data.graduatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "graduatedAt", "graduatedBy", "updatedAt"])
        && existsAfter(/databases/$(database)/documents/batchGraduations/$(batchId));
      allow delete: if false;
    }

    match /alumniConversions/{conversionId} {
      allow read: if signedIn()
        && (resource.data.studentUid == request.auth.uid || teacherAssignedToBatch(resource.data.batchId));
      allow create: if signedIn()
        && isTeacher()
        && request.resource.data.keys().hasOnly(["studentUid", "batchId", "previousRole", "newRole", "graduationYear", "convertedBy", "convertedAt"])
        && conversionId == request.resource.data.batchId + "_" + request.resource.data.studentUid
        && convertibleBatch(request.resource.data.batchId)
        && graduationYearReached(request.resource.data.batchId)
        && request.resource.data.studentUid is string
        && request.resource.data.previousRole == "student"
        && request.resource.data.newRole == "alumni"
        && request.resource.data.graduationYear == get(/databases/$(database)/documents/batches/$(request.resource.data.batchId)).data.graduationYear
        && request.resource.data.convertedBy == request.auth.uid
        && request.resource.data.convertedAt == request.time
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.studentUid)).data.role == "student"
        && getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.studentUid)).data.role == "alumni"
        && getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.studentUid)).data.batchId == request.resource.data.batchId
        && getAfter(/databases/$(database)/documents/profiles/$(request.resource.data.studentUid)).data.graduatedAt == request.time;
      allow update, delete: if false;
    }

    match /batchGraduations/{batchId} {
      allow read: if signedIn()
        && teacherAssignedToBatch(batchId);
      allow create: if signedIn()
        && isTeacher()
        && request.resource.data.keys().hasOnly(["batchId", "studentCount", "graduationYear", "graduatedBy", "graduatedAt"])
        && request.resource.data.batchId == batchId
        && teacherAssignedToBatch(batchId)
        && getAfter(/databases/$(database)/documents/batches/$(batchId)).data.status == "graduated"
        && request.resource.data.studentCount is int
        && request.resource.data.studentCount > 0
        && request.resource.data.graduationYear == get(/databases/$(database)/documents/batches/$(batchId)).data.graduationYear
        && request.resource.data.graduatedBy == request.auth.uid
        && request.resource.data.graduatedAt == request.time;
      allow update, delete: if false;
    }

    match /achievements/{achievementId} {
      allow read: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && currentProfile().role == "alumni";
      allow create: if signedIn()
        && currentProfile().role == "alumni"
        && achievementId.matches("^" + request.auth.uid + "_.+$")
        && request.resource.data.keys().hasOnly(["ownerUid", "title", "type", "description", "year", "createdAt", "updatedAt"])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.type in ["Certification", "Award", "Higher Studies", "Professional Achievement", "Other"]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.year is int
        && request.resource.data.year >= 1950
        && request.resource.data.year <= 2100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && currentProfile().role == "alumni"
        && resource.data.ownerUid == request.auth.uid;
    }

    match /uniqueMobileNumbers/{mobile} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/uniqueMobileNumbers/$(mobile))
        && request.resource.data.keys().hasOnly(["uid", "role", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["student", "teacher"]
        && mobile.matches("^[6-9][0-9]{9}$")
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.mobile == mobile
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == request.resource.data.role
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    match /uniqueRegisterNumbers/{regNo} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/uniqueRegisterNumbers/$(regNo))
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && regNo.matches("^[0-9]{2}[A-Z]{3}[0-9]{3}$")
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.regNo == regNo
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    match /uniqueTeacherScopes/{scopeId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/uniqueTeacherScopes/$(scopeId))
        && request.resource.data.keys().hasOnly(["uid", "department", "departmentKey", "teachingBatch", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == "teacher"
        && allowedDepartment(request.resource.data.department)
        && validAcademicYear(request.resource.data.teachingBatch)
        && validDepartmentKey(request.resource.data)
        && scopeId == request.resource.data.departmentKey + "_" + request.resource.data.teachingBatch
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
  }
}
