{
  "name": "student-digital-locker-github-ready",
  "version": "1.0.0",
  "private": true,
  "description": "Student Digital Locker static frontend with Firebase Auth and Firestore.",
  "scripts": {
    "dev": "node scripts/local-server.js",
    "config:firebase": "node scripts/generate-firebase-config.js",
    "build": "node scripts/verify-static-site.js",
    "pages:artifact": "node scripts/prepare-pages-artifact.js",
    "deploy:firebase": "npx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "start": "npm run dev"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "firebase": "^12.16.0"
  }
}
