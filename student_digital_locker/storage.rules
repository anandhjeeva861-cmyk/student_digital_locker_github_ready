rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userProfile(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function isTeacher() {
      return signedIn() && myProfile().data.role == "teacher";
    }

    function teacherCanAccessOwner(uid) {
      return isTeacher()
        && userProfile(uid).data.role == "student"
        && userProfile(uid).data.departmentKey == myProfile().data.departmentKey
        && userProfile(uid).data.year == myProfile().data.year;
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /documents/{uid}/{category}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && category in ["online", "personal", "academic"]
        && request.resource.size < 16 * 1024 * 1024;

      allow read, delete: if signedIn()
        && (
          request.auth.uid == uid
          || (
            category == "academic"
            && resource.metadata.category == "academic"
            && resource.metadata.ownerUid == uid
            && teacherCanAccessOwner(uid)
          )
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
